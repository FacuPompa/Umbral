# Desarrollo local usa las credenciales por defecto de application.properties.
# En Render, configurar estas variables desde el panel; nunca pegarlas acá:
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# UMBRAL_CORS_ALLOWED_ORIGIN=https://tu-sitio.netlify.app
# UMBRAL_SESSION_COOKIE_SAME_SITE=Lax
# UMBRAL_SESSION_COOKIE_SECURE=true

# RAWG se usa desde Spring para buscar ediciones antes de moderarlas.
RAWG_API_KEY=

# JWT: generar fuera de Git con openssl rand -base64 48.
# Obligatorio en desarrollo y Render; nunca usar una variable VITE_ para esto.
UMBRAL_JWT_SECRET=

# Netlify: dejar VITE_API_BASE_URL vacía/eliminarla y reconstruir el frontend.
# /api se envía a Render mediante frontend/public/_redirects (antes del fallback SPA).
# Render: UMBRAL_CORS_ALLOWED_ORIGIN debe coincidir con el dominio del frontend.
# Con el proxy, usar UMBRAL_SESSION_COOKIE_SAME_SITE=Lax y UMBRAL_SESSION_COOKIE_SECURE=true.
