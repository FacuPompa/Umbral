# Desarrollo local usa las credenciales por defecto de application.properties.
# En Render, configurar estas variables desde el panel; nunca pegarlas acá:
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# UMBRAL_CORS_ALLOWED_ORIGIN=https://tu-sitio.netlify.app
# UMBRAL_SESSION_COOKIE_SAME_SITE=None
# UMBRAL_SESSION_COOKIE_SECURE=true

# RAWG se usa desde Spring para buscar ediciones antes de moderarlas.
RAWG_API_KEY=
